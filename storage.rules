rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function taskExists(uid, taskId) {
      return firestore.exists(
        /databases/(default)/documents/users/$(uid)/tasks/$(taskId)
      );
    }

    match /users/{uid}/tasks/{taskId}/attachments/{path=**} {
      allow get, list: if owns(uid);
    }

    match /users/{uid}/tasks/{taskId}/attachments/{fileId} {
      allow create: if owns(uid)
        && resource == null
        && taskExists(uid, taskId)
        && fileId.matches('[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
        ]
        && request.resource.metadata.keys().hasOnly(['displayName'])
        && request.resource.metadata.displayName is string
        && request.resource.metadata.displayName.size() > 0
        && request.resource.metadata.displayName.size() <= 150;
      allow update: if false;
      allow delete: if owns(uid);
    }
  }
}
